<Window x:Class="PSI.Windows.SaleEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新增销售出库单" Width="760" Height="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8">
            <TextBlock Text="客户：" VerticalAlignment="Center"/>
            <ComboBox ItemsSource="{Binding Customers}"
                      SelectedItem="{Binding SelectedCustomer}"
                      DisplayMemberPath="Name" Width="220"/>
            <TextBlock Text="日期：" VerticalAlignment="Center" Margin="16,0,0,0"/>
            <DatePicker SelectedDate="{Binding OrderDate}" Width="140"/>
            <TextBlock Text="合计：" VerticalAlignment="Center" Margin="24,0,0,0"/>
            <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:N2} 元}"
                       FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="8">
            <Button Content="添加明细" Command="{Binding AddDetailCommand}" Width="80"/>
            <Button Content="删除明细" Command="{Binding RemoveDetailCommand}" Width="80" Margin="8,0,0,0"/>
            <Button Content="保存" Width="80" Margin="24,0,0,0" IsDefault="True" Click="SaveButton_Click"/>
            <Button Content="取消" Width="80" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>

        <DataGrid ItemsSource="{Binding Details}"
                  SelectedItem="{Binding SelectedDetail}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  Margin="8,0,8,8">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="商品" Width="220">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.Products, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding SelectedProduct, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMemberPath="Name" Margin="4,2"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="数量" Binding="{Binding Quantity}" Width="90"/>
                <DataGridTextColumn Header="单价" Binding="{Binding UnitPrice}" Width="110"/>
                <DataGridTextColumn Header="金额" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="120" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
