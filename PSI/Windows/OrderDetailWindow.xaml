<Window x:Class="PSI.Windows.OrderDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="640" Height="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <!-- 单据头：供应商/客户 + 单号 + 日期 + 合计，全部只读 -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8">
            <TextBlock Text="{Binding PartnerLabel, StringFormat={}{0}:}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding PartnerName}" VerticalAlignment="Center" Width="180"/>
            <TextBlock Text="单号：" VerticalAlignment="Center" Margin="16,0,0,0"/>
            <TextBlock Text="{Binding OrderNo}" VerticalAlignment="Center"/>
            <TextBlock Text="日期：" VerticalAlignment="Center" Margin="16,0,0,0"/>
            <TextBlock Text="{Binding OrderDate, StringFormat={}{0:yyyy-MM-dd}}" VerticalAlignment="Center"/>
            <TextBlock Text="合计：" VerticalAlignment="Center" Margin="24,0,0,0"/>
            <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:N2} 元}"
                       FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="8">
            <Button Content="关闭" Width="80" IsCancel="True"/>
        </StackPanel>

        <DataGrid ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  Margin="8,0,8,8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="商品" Binding="{Binding ProductName}" Width="220"/>
                <DataGridTextColumn Header="数量" Binding="{Binding Quantity}" Width="90"/>
                <DataGridTextColumn Header="单价" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" Width="110"/>
                <DataGridTextColumn Header="金额" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
