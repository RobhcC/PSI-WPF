<UserControl x:Class="PSI.Pages.ReportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8">
            <TextBlock Text="年份：" VerticalAlignment="Center"/>
            <ComboBox ItemsSource="{Binding Years}"
                      SelectedItem="{Binding SelectedYear}" Width="100"/>
            <Button Content="查询" Command="{Binding QueryCommand}" Width="60" Margin="8,0,0,0"/>
            <TextBlock Text="全年采购合计：" VerticalAlignment="Center" Margin="24,0,0,0"/>
            <TextBlock Text="{Binding TotalPurchase, StringFormat={}{0:N2} 元}" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Text="全年销售合计：" VerticalAlignment="Center" Margin="16,0,0,0"/>
            <TextBlock Text="{Binding TotalSale, StringFormat={}{0:N2} 元}" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 左右两张汇总表：同一年的采购、销售月度对比 -->
        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding PurchaseRows}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      Margin="0,0,4,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="采购月份" Binding="{Binding Month, StringFormat={}{0} 月}" Width="*"/>
                    <DataGridTextColumn Header="单据数" Binding="{Binding OrderCount}" Width="80"/>
                    <DataGridTextColumn Header="金额合计" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid Grid.Column="1"
                      ItemsSource="{Binding SaleRows}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      Margin="4,0,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="销售月份" Binding="{Binding Month, StringFormat={}{0} 月}" Width="*"/>
                    <DataGridTextColumn Header="单据数" Binding="{Binding OrderCount}" Width="80"/>
                    <DataGridTextColumn Header="金额合计" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</UserControl>
