<UserControl x:Class="PSI.Pages.PlaceholderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- 标题从 DataContext（PlaceholderViewModel.Title）绑定而来，页面自身无任何逻辑 -->
        <TextBlock Text="{Binding Title}" FontSize="22" Foreground="Gray"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</UserControl>
