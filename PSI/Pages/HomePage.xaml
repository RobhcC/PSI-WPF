<UserControl x:Class="PSI.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- 概览卡片公共样式：白底细边框圆角，和菜单按钮复用 Style 一个道理（类似 CSS 类） -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="经营概况" FontSize="20" FontWeight="Bold" Foreground="#333333"/>

            <!-- 第一行卡片：三张基础档案数 + 库存占用资金（结存×采购价） -->
            <UniformGrid Columns="4" Margin="0,14,0,0">
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="商品总数" Foreground="Gray"/>
                        <TextBlock Text="{Binding ProductCount}" FontSize="22" FontWeight="Bold" Foreground="#2B6CB0" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="供应商数" Foreground="Gray"/>
                        <TextBlock Text="{Binding SupplierCount}" FontSize="22" FontWeight="Bold" Foreground="#2B6CB0" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="客户数" Foreground="Gray"/>
                        <TextBlock Text="{Binding CustomerCount}" FontSize="22" FontWeight="Bold" Foreground="#2B6CB0" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="库存占用资金（采购价口径）" Foreground="Gray"/>
                        <TextBlock Text="{Binding StockValue, StringFormat={}{0:N0} 元}" FontSize="22" FontWeight="Bold" Foreground="#3B7A2C" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- 第二行卡片：今年的采购单数与销售额 -->
            <UniformGrid Columns="4" Margin="0,10,0,0">
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding StatYear, StringFormat={}{0} 年采购单数}" Foreground="Gray"/>
                        <TextBlock Text="{Binding PurchaseOrderCount}" FontSize="22" FontWeight="Bold" Foreground="#2B6CB0" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding StatYear, StringFormat={}{0} 年销售金额}" Foreground="Gray"/>
                        <TextBlock Text="{Binding SaleAmount, StringFormat={}{0:N0} 元}" FontSize="22" FontWeight="Bold" Foreground="#3B7A2C" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- 两张迷你榜：低库存提醒 + 畅销商品 -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="库存偏低提醒（结存最少前 5）" FontWeight="Bold" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding LowStockItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E5E5E5" BorderThickness="0,0,0,1" Padding="4,7">
                                    <Grid>
                                        <TextBlock Text="{Binding ProductName}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Quantity, StringFormat={}{0} 件}" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" FontWeight="Bold" Foreground="#C0504D"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="畅销商品 TOP 5（按销售金额）" FontWeight="Bold" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding HotProducts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E5E5E5" BorderThickness="0,0,0,1" Padding="4,7">
                                    <Grid>
                                        <TextBlock Text="{Binding ProductName}" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Quantity, StringFormat={}×{0}}" Foreground="Gray" Margin="0,0,12,0"/>
                                            <TextBlock Text="{Binding Amount, StringFormat={}{0:N0} 元}" FontWeight="Bold" Foreground="#2B6CB0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
