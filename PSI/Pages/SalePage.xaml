<UserControl x:Class="PSI.Pages.SalePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8">
            <TextBlock Text="单据编号：" VerticalAlignment="Center"/>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
            <Button Content="查询" Command="{Binding SearchCommand}" Width="60" Margin="8,0,0,0"/>
            <Button Content="新增销售单" Command="{Binding AddCommand}" Width="90" Margin="16,0,0,0"/>
        </StackPanel>

        <DataGrid ItemsSource="{Binding Orders}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  Margin="8,0,8,8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="单据编号" Binding="{Binding OrderNo}" Width="160"/>
                <DataGridTextColumn Header="客户" Binding="{Binding Customer.Name}" Width="200"/>
                <DataGridTextColumn Header="日期" Binding="{Binding OrderDate, StringFormat={}{0:yyyy-MM-dd}}" Width="110"/>
                <DataGridTextColumn Header="金额合计" Binding="{Binding TotalAmount, StringFormat={}{0:N2}}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
