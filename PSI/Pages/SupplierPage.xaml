<UserControl x:Class="PSI.Pages.SupplierPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8">
            <TextBlock Text="供应商名称：" VerticalAlignment="Center"/>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
            <Button Content="查询" Command="{Binding SearchCommand}" Width="60" Margin="8,0,0,0"/>
            <Button Content="新增" Command="{Binding AddCommand}" Width="60" Margin="16,0,0,0"/>
            <Button Content="编辑" Command="{Binding EditCommand}" Width="60" Margin="8,0,0,0"/>
            <Button Content="删除" Command="{Binding DeleteCommand}" Width="60" Margin="8,0,0,0"/>
        </StackPanel>

        <DataGrid ItemsSource="{Binding Suppliers}"
                  SelectedItem="{Binding SelectedSupplier}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  Margin="8,0,8,8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="供应商名称" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="联系人" Binding="{Binding ContactPerson}" Width="100"/>
                <DataGridTextColumn Header="电话" Binding="{Binding Phone}" Width="130"/>
                <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="250"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
