<UserControl x:Class="PSI.Pages.ProductPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <!-- 顶部工具栏：搜索 + 三个操作按钮（命令不可用时自动变灰） -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8">
            <TextBlock Text="商品名称：" VerticalAlignment="Center"/>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
            <Button Content="查询" Command="{Binding SearchCommand}" Width="60" Margin="8,0,0,0"/>
            <Button Content="新增" Command="{Binding AddCommand}" Width="60" Margin="16,0,0,0"/>
            <Button Content="编辑" Command="{Binding EditCommand}" Width="60" Margin="8,0,0,0"/>
            <Button Content="删除" Command="{Binding DeleteCommand}" Width="60" Margin="8,0,0,0"/>
        </StackPanel>

        <!-- 商品表格。IsReadOnly：表格只展示，修改走编辑弹窗（防止误改） -->
        <DataGrid ItemsSource="{Binding Products}"
                  SelectedItem="{Binding SelectedProduct}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  Margin="8,0,8,8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="商品名称" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="100"/>
                <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="60"/>
                <DataGridTextColumn Header="采购价" Binding="{Binding PurchasePrice, StringFormat={}{0:N2}}" Width="100"/>
                <DataGridTextColumn Header="销售价" Binding="{Binding SalePrice, StringFormat={}{0:N2}}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
