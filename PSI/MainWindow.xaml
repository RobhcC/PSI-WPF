<Window x:Class="PSI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PSI 进销存管理系统" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">

    <!-- 菜单按钮的公共样式：定义一次，下面 8 个按钮通过 Style 复用（类似网页里的 CSS 类） -->
    <Window.Resources>
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <!-- 鼠标悬停时给个背景色反馈，不然用户不知道点的是哪 -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D6E4F0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 两列布局：左列固定 180 像素宽放菜单，右列 * 号表示占满剩余全部宽度 -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧菜单区（StackPanel = 从上往下依次排列，不带滚动） -->
        <StackPanel Grid.Column="0" Background="#F2F2F2">
            <TextBlock Text="PSI 进销存" FontSize="18" FontWeight="Bold"
                       Foreground="#333333" Margin="14,18,0,14"/>
            <Button Content="首页" Style="{StaticResource MenuButton}" Click="MenuHome_Click"/>
            <Button Content="商品管理" Style="{StaticResource MenuButton}" Click="MenuProduct_Click"/>
            <Button Content="供应商管理" Style="{StaticResource MenuButton}" Click="MenuSupplier_Click"/>
            <Button Content="客户管理" Style="{StaticResource MenuButton}" Click="MenuCustomer_Click"/>
            <Button Content="采购入库" Style="{StaticResource MenuButton}" Click="MenuPurchase_Click"/>
            <Button Content="销售出库" Style="{StaticResource MenuButton}" Click="MenuSale_Click"/>
            <Button Content="库存查询" Style="{StaticResource MenuButton}" Click="MenuStock_Click"/>
            <Button Content="月度统计" Style="{StaticResource MenuButton}" Click="MenuReport_Click"/>
        </StackPanel>

        <!-- 右侧内容区：Frame 专门负责显示和切换 Page（页面容器） -->
        <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
