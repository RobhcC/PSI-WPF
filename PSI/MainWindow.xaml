<Window x:Class="PSI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:PSI.Pages"
        xmlns:vm="clr-namespace:PSI.ViewModels"
        Title="PSI 进销存管理系统" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- 菜单按钮的公共样式：定义一次，下面 8 个按钮通过 Style 复用（类似网页里的 CSS 类） -->
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <!-- 鼠标悬停时给个背景色反馈，不然用户不知道点的是哪 -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D6E4F0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataTemplate：告诉 WPF"这种 ViewModel 用哪个页面显示"。
             ContentControl 的内容换成哪个 VM，WPF 就按这里的映射自动创建对应页面 -->
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <pages:HomePage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductViewModel}">
            <pages:ProductPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SupplierViewModel}">
            <pages:SupplierPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CustomerViewModel}">
            <pages:CustomerPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PurchaseViewModel}">
            <pages:PurchasePage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SaleViewModel}">
            <pages:SalePage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StockViewModel}">
            <pages:StockPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportViewModel}">
            <pages:ReportPage/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- 两列布局：左列固定 180 像素宽放菜单，右列 * 号表示占满剩余全部宽度 -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧菜单区。注意：按钮不再写 Click 事件，改成绑定 ViewModel 里的命令 -->
        <StackPanel Grid.Column="0" Background="#F2F2F2">
            <TextBlock Text="PSI 进销存" FontSize="18" FontWeight="Bold"
                       Foreground="#333333" Margin="14,18,0,14"/>
            <Button Content="首页" Style="{StaticResource MenuButton}" Command="{Binding HomeCommand}"/>
            <Button Content="商品管理" Style="{StaticResource MenuButton}" Command="{Binding ProductCommand}"/>
            <Button Content="供应商管理" Style="{StaticResource MenuButton}" Command="{Binding SupplierCommand}"/>
            <Button Content="客户管理" Style="{StaticResource MenuButton}" Command="{Binding CustomerCommand}"/>
            <Button Content="采购入库" Style="{StaticResource MenuButton}" Command="{Binding PurchaseCommand}"/>
            <Button Content="销售出库" Style="{StaticResource MenuButton}" Command="{Binding SaleCommand}"/>
            <Button Content="库存查询" Style="{StaticResource MenuButton}" Command="{Binding StockCommand}"/>
            <Button Content="月度统计" Style="{StaticResource MenuButton}" Command="{Binding ReportCommand}"/>
        </StackPanel>

        <!-- 右侧内容区：ContentControl 只负责显示绑定给它的 ViewModel，
             具体用哪个页面渲染由上面的 DataTemplate 决定。
             旧版 Frame 自带导航状态，和 MVVM 的"状态归 VM 管"相冲，故弃用 -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}"/>
    </Grid>
</Window>
